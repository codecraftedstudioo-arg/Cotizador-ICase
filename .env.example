# Opcional. Sin VITE_PANEL_API_URL el cotizador usa JSON local (demo).
# Con VITE_PANEL_API_URL el Admin es la fuente de verdad (precios + dólar).

# Base del Market Admin (sin o con /api/v1; se normaliza).
# Ejemplo: https://tu-admin.ejemplo.com
# Endpoints usados: /api/v1/cotizador-prices, /api/v1/exchange-rate, /api/v1/market-items
VITE_PANEL_API_URL=

# Solo si NO hay Admin: tipo de cambio vía URL propia (p. ej. Apps Script)
VITE_EXCHANGE_RATE_URL=

# Solo si NO hay Admin: catálogo Market remoto. Si está vacío → market-pricing.json
VITE_MARKET_PRICES_URL=

# Webhook de CRM. Solo se usa si tenant.crm.enabled y tenant.features.crm son true.
VITE_CRM_WEBHOOK_URL=
